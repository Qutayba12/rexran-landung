# Rexran — environment variables reference.
# Copy real values into Vercel → Project → Settings → Environment Variables.
# NEVER commit real secrets. This file only documents the names.
#
# IMPORTANT: VITE_* vars are baked in at BUILD time, so after adding or
# changing one you MUST redeploy (a new build) for it to take effect.

# ── Analytics / advertising (client, PUBLIC — safe to expose) ──────────────
# Google Analytics 4 Measurement ID (Admin → Data streams → your web stream).
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Meta (Facebook/Instagram) Pixel ID. NOTE: also needs the CSP updated in
# vercel.json to allow connect.facebook.net, or the pixel is blocked.
VITE_META_PIXEL_ID=

# ── Payments (server, SECRET) ──────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Database — Upstash Redis (server, SECRET) ──────────────────────────────
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# ── Media storage — Cloudflare R2 (server, SECRET) ─────────────────────────
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET=xxx
R2_PUBLIC_BASE_URL=https://cdn.example.com

# ── Admin panel (server, SECRET) ───────────────────────────────────────────
ADMIN_PASSWORD=xxx

# ── Order notifications — email via Resend (server, SECRET) ────────────────
RESEND_API_KEY=re_xxx
ORDER_EMAIL=orders@yourdomain.com
ORDER_FROM=Rexran <no-reply@yourdomain.com>

# ── Order notifications — Telegram (server, SECRET) ────────────────────────
TELEGRAM_BOT_TOKEN=xxx
TELEGRAM_CHAT_ID=xxx
